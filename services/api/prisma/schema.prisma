generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String       @id @default(uuid())
  name      String
  industry  String?
  users     User[]
  scans     Scan[]
  dsrRequests DsrRequest[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  stripeCustomerId    String?
  subscriptionStatus  String       @default("free") // free, active, past_due, canceled
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  passwordHash         String
  fullName             String
  role                 String       @default("MEMBER")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String
  emailVerified        Boolean      @default(false)
  emailVerifyTokenHash String?      // SHA-256 hash of the token sent by email -- never store the raw token
  emailVerifyExpires   DateTime?
  passwordResetTokenHash String?
  passwordResetExpires   DateTime?
  requiresPasswordChange Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Scan {
  id                 String       @id @default(uuid())
  scanType           String
  targetIdentifier   String
  status             String       @default("PENDING")
  score              Int?
  riskLevel          String?
  findingsJson       Json?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId     String?
  // Only set for anonymous /api/public/scan results. SHA-256 hash of a
  // one-time token returned to whoever ran the free scan -- required to
  // claim the scan onto an org at registration, since the scan id alone
  // isn't proof of ownership (it can end up in a shared link, browser
  // history, or referrer header).
  claimTokenHash     String?
  claimTokenExpires  DateTime?
  createdAt          DateTime     @default(now())
  completedAt        DateTime?
}

model DsrRequest {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  subjectEmail   String
  subjectName    String?
  requestType    String // ACCESS, ERASURE, RECTIFICATION, PORTABILITY, RESTRICTION
  status         String       @default("PENDING") // PENDING, IN_REVIEW, APPROVED, REJECTED, COMPLETED
  reasonText     String?
  internalNotes  String?
  dueDate        DateTime // GDPR mandates strict deadlines (e.g. 30 days)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, status])
}

model SuppressionList {
  email      String   @id
  reason     String   // BOUNCE, COMPLAINT
  detail     String?  // bounce subtype or diagnostic code
  createdAt  DateTime @default(now())
}
