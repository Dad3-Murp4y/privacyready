{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "PostgreSQL Connection Pool Status (Prisma DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "pg_stat_activity_count{state=\"idle\"}",
          "legendFormat": "Idle Connections"
        }
      ]
    },
    {
      "title": "Database Query Latency (P95 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(prisma_query_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Query Latency (ms)"
        }
      ]
    },
    {
      "title": "Redis Cache Hit Ratio (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100",
          "legendFormat": "Hit Ratio (%)"
        }
      ]
    },
    {
      "title": "Redis Memory & Client Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Memory Used (MB)"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Connected Clients"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["privacyready", "database", "redis", "prisma"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "PrivacyReady - Database & Redis Caching",
  "uid": "privacyready-database-redis-health"
}
